{
  "name": "kotakin-mobile-automation",
  "version": "1.0.0",
  "description": "Mobile test automation for the Kotakin Android app: WebdriverIO, Appium 2, Cucumber BDD, Allure",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/fraharjo/kotakin-mobile-automation.git"
  },
  "scripts": {
    "test": "npm run test:android",
    "test:android": "wdio run wdio.android.conf.ts --cucumberOpts.tags=\"@automated and not @manual\"",
    "test:smoke": "wdio run wdio.android.conf.ts --cucumberOpts.tags=\"@smoke and not @manual\"",
    "test:regression": "wdio run wdio.android.conf.ts --cucumberOpts.tags=\"@regression and not @manual\"",
    "test:feature:onboarding": "wdio run wdio.android.conf.ts --cucumberOpts.tags=\"@feature-onboarding and @automated\"",
    "test:feature:box": "wdio run wdio.android.conf.ts --cucumberOpts.tags=\"@feature-box and @automated\"",
    "test:feature:item": "wdio run wdio.android.conf.ts --cucumberOpts.tags=\"@feature-item and @automated\"",
    "test:feature:scanner": "wdio run wdio.android.conf.ts --cucumberOpts.tags=\"@feature-scanner and @automated\"",
    "test:feature:settings": "wdio run wdio.android.conf.ts --cucumberOpts.tags=\"@feature-settings and @automated\"",
    "typecheck": "tsc --noEmit",
    "docs:generate": "ts-node scripts/generate-docs.ts",
    "appium:setup": "appium driver install uiautomator2",
    "report:generate": "allure generate ./reports/allure-results --clean -o ./reports/allure-report",
    "report:open": "allure open ./reports/allure-report",
    "report": "npm run report:generate && npm run report:open",
    "lint:tags": "ts-node scripts/lint-tags.ts",
    "test:manual:dashboard": "ts-node scripts/manual-dashboard/server.ts"
  },
  "keywords": [
    "webdriverio",
    "appium",
    "cucumber",
    "bdd",
    "typescript",
    "allure",
    "kotakin",
    "android-automation"
  ],
  "author": "Fadli Raharjo",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@wdio/allure-reporter": "^8.32.0",
    "@wdio/appium-service": "^8.32.0",
    "@wdio/cli": "^8.32.0",
    "@wdio/cucumber-framework": "^8.32.0",
    "@wdio/local-runner": "^8.32.0",
    "@wdio/spec-reporter": "^8.32.0",
    "allure-commandline": "^2.27.0",
    "appium": "^2.5.0",
    "appium-uiautomator2-driver": "^3.0.0",
    "dotenv": "^16.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
