# ==========================================
# KOTAKIN MOBILE AUTOMATION - ENVIRONMENT CONFIGURATION
# Salin file ini menjadi .env lalu sesuaikan nilainya:
# cp .env.example .env
# ==========================================

# --- Appium & Device Configuration ---
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
ANDROID_DEVICE_NAME=Android Emulator
ANDROID_PLATFORM_VERSION=13.0
ANDROID_APP_PATH=./apps/kotakin.apk
ANDROID_APP_ID=com.bmolab.kotakin

# --- Test Execution Preferences ---
DEFAULT_LOCALE=en
TIMEOUT_EXPLICIT=15000
ALLURE_AUTO_OPEN=true
